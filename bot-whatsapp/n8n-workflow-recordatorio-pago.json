{
  "name": "Recordatorio de pago pendiente",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        },
        "timezone": "America/Argentina/Buenos_Aires"
      },
      "id": "d1000000-0000-0000-0000-000000000001",
      "name": "Cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH last_alias AS (\n  SELECT session_id, MAX(created_at) AS alias_at\n  FROM chat_history\n  WHERE role = 'assistant' AND content LIKE '%Alias: productoscapilarespg%'\n  GROUP BY session_id\n)\nSELECT la.session_id, la.alias_at\nFROM last_alias la\nWHERE la.session_id LIKE '%@s.whatsapp.net'\n  AND la.alias_at < now() - interval '3 hours'\n  AND la.alias_at > now() - interval '48 hours'\n  AND EXTRACT(HOUR FROM now() AT TIME ZONE 'America/Argentina/Buenos_Aires') BETWEEN 9 AND 21\n  AND NOT EXISTS (\n    SELECT 1 FROM chat_history ch\n    WHERE ch.session_id = la.session_id\n      AND ch.created_at > la.alias_at\n      AND (\n        ch.content LIKE '[Imagen recibida%'\n        OR ch.content LIKE '%[recordatorio_pago]%'\n      )\n  )\n  AND COALESCE((\n    SELECT content FROM chat_history\n    WHERE session_id = '__paused_customer__:' || right(regexp_replace(la.session_id, '\\D', '', 'g'), 10)\n    ORDER BY id DESC LIMIT 1\n  ), 'active') <> 'paused'\n  AND COALESCE((\n    SELECT content FROM chat_history WHERE session_id = '__bot_status__' ORDER BY id DESC LIMIT 1\n  ), 'active') <> 'paused'",
        "options": {}
      },
      "id": "d1000000-0000-0000-0000-000000000002",
      "name": "Buscar pagos pendientes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "cDyIo0T2342kI0Qh",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = 'Hola! ¿Cómo estás? Quería consultarte si te quedó alguna duda con la transferencia o necesitás una mano para completarla. Cualquier cosa, estoy para ayudarte 🌿';\nreturn items.map(item => ({\n  json: {\n    sessionId: item.json.session_id,\n    text,\n    logText: text + '\\n[recordatorio_pago]'\n  }\n}));\n"
      },
      "id": "d1000000-0000-0000-0000-000000000003",
      "name": "Armar recordatorio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://evo.productoscapilarespg.com/message/sendText/pg",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  number: $json.sessionId,\n  text: $json.text\n}) }}",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "d1000000-0000-0000-0000-000000000004",
      "name": "Enviar recordatorio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "aJOTrB9KcVsbm5Zq",
          "name": "Evolution apikey"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO chat_history (session_id, role, content) VALUES ($1, 'assistant', $2)",
        "options": {
          "queryReplacement": "={{ [ $json.sessionId, $json.logText ] }}"
        }
      },
      "id": "d1000000-0000-0000-0000-000000000005",
      "name": "Registrar recordatorio enviado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        880,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "cDyIo0T2342kI0Qh",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "recordatorio-pago-manual",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "d1000000-0000-0000-0000-000000000006",
      "name": "Disparo manual",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        160
      ],
      "webhookId": "recordatorio-pago-manual"
    }
  ],
  "connections": {
    "Cada hora": {
      "main": [
        [
          {
            "node": "Buscar pagos pendientes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar pagos pendientes": {
      "main": [
        [
          {
            "node": "Armar recordatorio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Armar recordatorio": {
      "main": [
        [
          {
            "node": "Enviar recordatorio",
            "type": "main",
            "index": 0
          },
          {
            "node": "Registrar recordatorio enviado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Disparo manual": {
      "main": [
        [
          {
            "node": "Buscar pagos pendientes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "paPVYhKtE3AU7IJA"
  }
}
